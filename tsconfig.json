{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "tests", "playwright.config.ts", "vite.config.ts"]
}
